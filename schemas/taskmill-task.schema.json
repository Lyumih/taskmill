{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Taskmill task file",
  "type": "object",
  "required": ["schemaVersion", "task"],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "schemaVersion": { "const": 1 },
    "task": {
      "type": "object",
      "required": ["id", "title", "type", "processId"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
        "title": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1 },
        "processId": { "type": "string", "minLength": 1 },
        "processOverride": {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "summary": { "type": "string" },
            "taskType": { "type": "string", "minLength": 1 },
            "trigger": { "type": "string" },
            "agent": { "type": "string" },
            "enabled": { "type": "boolean" },
            "placeholder": { "type": "boolean" },
            "stages": { "$ref": "#/definitions/stages" },
            "blocks": { "$ref": "#/definitions/blocks" }
          },
          "additionalProperties": false
        },
        "pluginData": {
          "type": "object",
          "additionalProperties": { "$ref": "#/definitions/pluginBlocks" }
        },
        "pluginNotes": {
          "type": "object",
          "additionalProperties": { "$ref": "#/definitions/pluginNotesByBlock" }
        },
        "status": { "type": "string" },
        "priority": { "type": "string" },
        "project": {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "repository": { "type": "string" },
            "branch": { "type": "string" },
            "rootPath": { "type": "string" }
          },
          "additionalProperties": false
        },
        "description": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "definitions": {
    "stages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "detail", "status"],
        "properties": {
          "title": { "type": "string" },
          "detail": { "type": "string" },
          "status": { "enum": ["done", "current", "pending"] }
        },
        "additionalProperties": false
      }
    },
    "blocks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "pluginId", "enabled"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "pluginId": { "type": "string", "minLength": 1 },
          "enabled": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    },
    "jsonObject": {
      "type": "object",
      "additionalProperties": { "$ref": "#/definitions/jsonValue" }
    },
    "jsonValue": {
      "anyOf": [
        { "type": ["string", "number", "boolean", "null"] },
        { "type": "array", "items": { "$ref": "#/definitions/jsonValue" } },
        { "$ref": "#/definitions/jsonObject" }
      ]
    },
    "pluginBlocks": {
      "type": "object",
      "additionalProperties": { "$ref": "#/definitions/jsonObject" }
    },
    "pluginNotesByBlock": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": { "type": "string" }
      }
    }
  },
  "additionalProperties": false
}
